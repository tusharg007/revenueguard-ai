# RevenueGuard AI environment template

# App
APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
# Local default uses SQLite. For Docker/Postgres use:
# postgresql+asyncpg://revenueguard:revenueguard@localhost:5432/revenueguard
DATABASE_URL=sqlite+aiosqlite:///./revenueguard.db

# Redis queue, websocket relay, and gateway health windows
REDIS_URL=redis://localhost:6379

# Razorpay sandbox/live credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM provider used by the LangGraph agent
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Recovery policy controls
HIGH_VALUE_THRESHOLD=5000000
MAX_RETRY_ATTEMPTS=3
COOLDOWN_HOURS=24
QUIET_HOURS_START=21
QUIET_HOURS_END=9

# Experiment split
EXPERIMENT_VARIANT_PCT=20

# Human approval integration
N8N_APPROVAL_WEBHOOK_URL=
